DISCORD_TOKEN=your_discord_token_here
OWNER_ID=your_owner_discord_id_here
DISCORD_PREFIX=?
ALLOWED_USERS=user_id1,user_id2,user_id3
MP3_API_KEY=your_mp3_downloader_api_key_here
# Paste the FULL content of your exported cookies.txt here (Netscape format,
# from a cookie-editor extension while logged into YouTube). Multiline is fine.
YOUTUBE_COOKIES=
# YouTube Data API v3 key (free from Google Cloud Console). Used for song
# search + playlists. If empty, the bot falls back to yt-dlp search.
YOUTUBE_API_KEY=
